rules_version = '2';

// Burner — Cloud Firestore rules.
// Keep the limits in sync with DropLimits in lib/services/drop_service.dart.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // drops/{id}: one document per drop.
    //  - private drops: id is the 6-char code; signed-in users only.
    //  - public drops: id is a 24-char secret token from the share link;
    //    anyone with the link (no sign-in) can open it once.
    match /drops/{code} {
      function isOwner() {
        return signedIn() && resource.data.ownerUid == request.auth.uid;
      }

      function isPublic() {
        return resource.data.get('public', false) == true;
      }

      function isLive() {
        return resource.data.expiresAt > request.time
          && resource.data.burned != true;
      }

      // Signed-in users, or anyone for a public drop.
      function canOpen() {
        return isLive() && (signedIn() || isPublic());
      }

      function dropFields() {
        return ['ownerUid', 'text', 'files', 'createdAt', 'expiresAt',
                'burnAfterRead', 'public', 'burned', 'downloads'];
      }

      function validId() {
        let d = request.resource.data;
        return (d.public == false
                && code.matches('^[ABCDEFGHJKLMNPQRSTUVWXYZ23456789]{6}$'))
          || (d.public == true
                && code.matches('^[A-Za-z0-9]{24}$')
                && d.burnAfterRead == true);
      }

      // Opening: +1 download, and for burn-after-read drops set burned=true
      // with burnedAt = server time. Nothing else may change.
      function validOpen() {
        let d = request.resource.data;
        let changed = d.diff(resource.data).affectedKeys();
        return changed.hasOnly(['downloads', 'burned', 'burnedAt'])
          && d.downloads == resource.data.downloads + 1
          && ((!changed.hasAny(['burned', 'burnedAt'])
               && resource.data.burnAfterRead != true)
              || (resource.data.burnAfterRead == true
                  && d.burned == true
                  && d.burnedAt == request.time));
      }

      // Owners can always read their own (to clean up expired ones).
      allow get: if isOwner() || canOpen();

      // Listing is only for "my drops": the query must filter on ownerUid.
      allow list: if signedIn() && resource.data.ownerUid == request.auth.uid;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(dropFields())
        && request.resource.data.keys().hasAll(dropFields())
        && request.resource.data.public is bool
        && validId()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 100000
        && request.resource.data.files is list
        && request.resource.data.files.size() <= 20
        && (request.resource.data.text.size() > 0
            || request.resource.data.files.size() > 0)
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        // 7 days + 5 minutes of client clock skew.
        && request.resource.data.expiresAt <= request.time + duration.value(10085, 'm')
        && request.resource.data.burnAfterRead is bool
        && request.resource.data.burned == false
        && request.resource.data.downloads == 0;

      allow update: if !isOwner() && canOpen() && validOpen();

      allow delete: if isOwner();
    }

    // users/{uid}: self-reported usage counters. Counters can only grow.
    match /users/{uid} {
      function counters() {
        return ['dropsCreated', 'bytesUploaded', 'dropsReceived', 'bytesDownloaded'];
      }

      function validCounters() {
        let d = request.resource.data;
        return d.keys().hasOnly(counters().concat(['lastActiveAt']))
          && d.get('dropsCreated', 0) is int
          && d.get('bytesUploaded', 0) is int
          && d.get('dropsReceived', 0) is int
          && d.get('bytesDownloaded', 0) is int
          && d.get('lastActiveAt', request.time) is timestamp;
      }

      function nonDecreasing() {
        let d = request.resource.data;
        let old = resource.data;
        return d.get('dropsCreated', 0) >= old.get('dropsCreated', 0)
          && d.get('bytesUploaded', 0) >= old.get('bytesUploaded', 0)
          && d.get('dropsReceived', 0) >= old.get('dropsReceived', 0)
          && d.get('bytesDownloaded', 0) >= old.get('bytesDownloaded', 0);
      }

      allow get: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid && validCounters();
      allow update: if signedIn() && request.auth.uid == uid
        && validCounters() && nonDecreasing();
    }

    // Everything else is closed.
  }
}
