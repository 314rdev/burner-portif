rules_version = '2';

// Burner — Cloud Firestore rules.
// Keep the limits in sync with DropLimits in lib/services/drop_service.dart.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // drops/{code}: one document per drop; the 6-char code is the doc id.
    match /drops/{code} {
      function isOwner() {
        return resource.data.ownerUid == request.auth.uid;
      }

      function isLive() {
        return resource.data.expiresAt > request.time
          && resource.data.burned != true;
      }

      function dropFields() {
        return ['ownerUid', 'text', 'files', 'createdAt', 'expiresAt',
                'burnAfterRead', 'burned', 'downloads'];
      }

      // Anyone signed in who knows the code may read a live drop.
      // Owners can always read their own (to clean up expired ones).
      allow get: if signedIn() && (isOwner() || isLive());

      // Listing is only for "my drops": the query must filter on ownerUid.
      allow list: if signedIn() && resource.data.ownerUid == request.auth.uid;

      allow create: if signedIn()
        && code.matches('^[ABCDEFGHJKLMNPQRSTUVWXYZ23456789]{6}$')
        && request.resource.data.keys().hasOnly(dropFields())
        && request.resource.data.keys().hasAll(dropFields())
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 100000
        && request.resource.data.files is list
        && request.resource.data.files.size() <= 20
        && (request.resource.data.text.size() > 0
            || request.resource.data.files.size() > 0)
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        // 7 days + 5 minutes of client clock skew.
        && request.resource.data.expiresAt <= request.time + duration.value(10085, 'm')
        && request.resource.data.burnAfterRead is bool
        && request.resource.data.burned == false
        && request.resource.data.downloads == 0;

      // A recipient opening a live drop: +1 download, and burn it if it is
      // burn-after-read. Nothing else may change.
      allow update: if signedIn()
        && !isOwner()
        && isLive()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['downloads', 'burned'])
        && request.resource.data.downloads == resource.data.downloads + 1
        && (request.resource.data.burned == resource.data.burned
            || (resource.data.burnAfterRead == true
                && request.resource.data.burned == true));

      allow delete: if signedIn() && isOwner();
    }

    // users/{uid}: self-reported usage counters. Counters can only grow.
    match /users/{uid} {
      function counters() {
        return ['dropsCreated', 'bytesUploaded', 'dropsReceived', 'bytesDownloaded'];
      }

      function validCounters() {
        let d = request.resource.data;
        return d.keys().hasOnly(counters().concat(['lastActiveAt']))
          && d.get('dropsCreated', 0) is int
          && d.get('bytesUploaded', 0) is int
          && d.get('dropsReceived', 0) is int
          && d.get('bytesDownloaded', 0) is int
          && d.get('lastActiveAt', request.time) is timestamp;
      }

      function nonDecreasing() {
        let d = request.resource.data;
        let old = resource.data;
        return d.get('dropsCreated', 0) >= old.get('dropsCreated', 0)
          && d.get('bytesUploaded', 0) >= old.get('bytesUploaded', 0)
          && d.get('dropsReceived', 0) >= old.get('dropsReceived', 0)
          && d.get('bytesDownloaded', 0) >= old.get('bytesDownloaded', 0);
      }

      allow get: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid && validCounters();
      allow update: if signedIn() && request.auth.uid == uid
        && validCounters() && nonDecreasing();
    }

    // Everything else is closed.
  }
}
