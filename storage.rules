rules_version = '2';

// Burner — Cloud Storage rules.
// Objects live at drops/{ownerUid}/{folder}/{index}_{fileName}, where folder is
//  - a 20-char random id for private drops, or
//  - the drop's 24-char public token for public-link drops.
// Keep limits in sync with DropLimits / DropService in lib/services/drop_service.dart.
//
// publicDropOpen() reads Firestore (a cross-service rule). The Storage service
// agent needs roles/firebaserules.firestoreServiceAgent for that, or public
// downloads get 403. `firebase deploy` offers to grant it, but only in an
// interactive run (not with --non-interactive) and only when this file changed.
service firebase.storage {
  match /b/{bucket}/o {
    match /drops/{uid}/{folder}/{fileName} {
      // Token-less download of a public drop: the drop must exist, be public,
      // not expired, and either unopened or opened less than 15 minutes ago
      // (so the receiver can finish downloading after the drop burns).
      function publicDropOpen() {
        let drop = firestore.get(/databases/(default)/documents/drops/$(folder)).data;
        return drop.get('public', false) == true
          && drop.expiresAt > request.time
          && (drop.burned != true
              || request.time < drop.burnedAt + duration.value(15, 'm'));
      }

      // Signed-in users may download any drop file. The random folder id is
      // only revealed through a drop document, which Firestore rules guard.
      allow get: if request.auth != null
        || (folder.matches('^[A-Za-z0-9]{24}$') && publicDropOpen());

      // Only the owner uploads into their own folder; no overwrites.
      allow create: if request.auth != null
        && request.auth.uid == uid
        && folder.matches('^[A-Za-z0-9]{20}$|^[A-Za-z0-9]{24}$')
        && request.resource.size <= 100 * 1024 * 1024;

      allow delete: if request.auth != null && request.auth.uid == uid;

      // No list, no update.
    }
  }
}
